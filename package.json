{
  "name": "hamburgueria-na-brasa-functions",
  "private": true,
  "version": "1.0.0",
  "description": "Trusted Firebase Functions for Hamburgueria Na Brasa.",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "lint": "node --check index.js && node --check scripts/set-manager-claim.js && node --check ../scripts/seed-products.js",
    "test": "node --check index.js",
    "serve": "firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions,firestore,hosting",
    "seed:products": "node ../scripts/seed-products.js",
    "set:manager": "node scripts/set-manager-claim.js"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1"
  }
}
